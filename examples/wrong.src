// Недопустимые символы
fn main() {
    int @x = 10;      // @ недопустим
    int #y = 20;      // # недопустим
    int $z = 30;      // $ недопустим
    int `w = 40;      // ` недопустим
    int ~v = 50;      // ~ недопустим
    
    int a = 10€;      // € недопустим
    float b = 20£;    // £ недопустим
    
    return 0;
}